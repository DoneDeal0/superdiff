{
  "exclude": ["node_modules", "dist"],
  "include": ["src"],
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "noUnusedParameters": true,
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "noImplicitAny": true,
    "noEmit": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true ,
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@mocks/*": ["./src/mocks/*"],
      "@models/*": ["./src/models/*"]
    }
  },
}
